#!/bin/bash

# Path to PID file and launch.json
BASE_DIR="/home/gauravgokhale/.config/nvim/scripts_tmpi/tmpi_trial"
pid_file="$BASE_DIR/hello_mpi_pids.txt"
SOURCE_FILE="$BASE_DIR/hello_mpi.cpp"

# Get process index from command line argument
process_num=${1:-1}  # Default to 1 if not provided

# Check if the PID file exists
if [ ! -f "$pid_file" ]; then
    echo "Error: PID file not found at $pid_file"
    echo "Please run start_mpi_processes.sh first to generate the file."
    exit 1
fi

# Get total number of MPI processes
total_procs=$(wc -l < "$pid_file")

# Validate process number
if [ "$process_num" -gt "$total_procs" ] || [ "$process_num" -lt 1 ]; then
    echo "Error: Invalid process number: $process_num. Valid range is 1-$total_procs"
    exit 1
fi

# Get the selected PID based on process_num
selected_pid=$(sed -n "${process_num}p" "$pid_file")
if [ -z "$selected_pid" ]; then
    echo "Error: Could not find PID for process $process_num"
    exit 1
fi

# Verify that the process is still running
if ! ps -p $selected_pid > /dev/null; then
    echo "Error: Process with PID $selected_pid is not running"
    exit 1
fi

echo "Attaching to MPI process $process_num with PID: $selected_pid"

# Create a unique debugging configuration file for this process
debug_config="$BASE_DIR/debug_config_${process_num}.json"
cat > "$debug_config" << EOL
{
  "configurations": [
    {
      "type": "cppdbg",
      "request": "attach",
      "name": "MPI Process $process_num Attach",
      "processId": ${selected_pid},
      "program": "$BASE_DIR/hello_mpi",
      "cwd": "$BASE_DIR",
      "stopAtEntry": true,
      "setupCommands": [
        {
          "text": "-enable-pretty-printing",
          "description": "Enable pretty printing",
          "ignoreFailures": true
        }
      ]
    }
  ]
}
EOL

# Create a temporary Vim script file without using nested heredocs
nvim_script="$BASE_DIR/attach_debugger_${process_num}.vim"

# Create the content of the script directly
cat > "$nvim_script" << EOVIM
" Check if we're inside Neovim
if has('nvim')
  " Attach to the MPI process using nvim-dap
  lua << EOF
  local pid = PROCESS_ID_PLACEHOLDER
  print("Attaching to MPI process $process_num with PID: " .. pid)
  
  -- Use the existing Neovim DAP setup
  local status_ok, dap = pcall(require, "dap")
  if not status_ok then
    print("ERROR: nvim-dap is not installed or not configured properly")
    print("Please make sure nvim-dap is installed in your Neovim configuration")
    return
  end
  
  -- Load the debug configuration
  local config_file = io.open("DEBUG_CONFIG_PLACEHOLDER", "r")
  if not config_file then
    print("ERROR: Could not open debug configuration file")
    return
  end
  
  local config_content = config_file:read("*all")
  config_file:close()
  
  local config = vim.json.decode(config_content)
  
  -- Set the configuration
  if config and config.configurations and config.configurations[1] then
    -- Configure for C/C++
    dap.configurations.cpp = dap.configurations.cpp or {}
    table.insert(dap.configurations.cpp, config.configurations[1])
    dap.configurations.c = dap.configurations.c or {}
    table.insert(dap.configurations.c, config.configurations[1])
    
    -- Start debugging session
    vim.defer_fn(function()
      dap.run(config.configurations[1])
    end, 500)
  end
EOF
else
  echo "This script requires Neovim"
endif
EOVIM

# Replace the placeholders in the vim script
sed -i "s/PROCESS_ID_PLACEHOLDER/$selected_pid/g" "$nvim_script"
sed -i "s|DEBUG_CONFIG_PLACEHOLDER|$debug_config|g" "$nvim_script"

# Launch Neovim with our script
nvim -S "$nvim_script" "$SOURCE_FILE"

echo "Debug session for process $process_num ended"